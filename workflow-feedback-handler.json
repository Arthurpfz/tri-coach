      {
        "id": "format-training",
        "name": "Format Training",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1260,
          100
        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "jsCode": "// Format current week's training plan as a Telegram message.\nconst plans = $input.all().map(i => i.json);\nif (!plans.length) {\n  return [{ json: { text: '📋 No training plan found for this week. The Sunday Planner runs every Sunday at 20:07 — check back then.' } }];\n}\nconst p = plans[0];\nconst days = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];\nconst dayEmoji = { Monday: 'Mo', Tuesday: 'Tu', Wednesday: 'We', Thursday: 'Th', Friday: 'Fr', Saturday: 'Sa', Sunday: 'Su' };\n\nconst lines = [`🗓 Week of ${p['Week Start Date']}`];\nif (p.Focus) lines.push(`Focus: ${p.Focus}`);\nlines.push('');\nfor (const d of days) {\n  const session = (p[d] || 'REST').trim();\n  lines.push(`${dayEmoji[d]} ${d}`);\n  lines.push(session);\n  lines.push('');\n}\nreturn [{ json: { text: lines.join('\\n').trim() } }];"
        }
