    {
      "id": "format-strikes",
      "name": "Format Strikes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        -100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Aggregate duration_min by sport for the running week — same logic as Weekly Stats workflow.\nconst sessions = $input.all().map(i => i.json);\nconst totalMin = sessions.reduce((sum, s) => sum + (s.duration_min || 0), 0);\nconst totalH = totalMin / 60;\nconst fires = '🔥'.repeat(Math.floor(totalH)) || '·';\n\nconst sportEmoji = { Run: '🏃 Run', Swim: '🏊 Swim', Ride: '🚴 Ride', Workout: '💪 Workout' };\nconst order = ['Run', 'Swim', 'Ride', 'Workout'];\nconst totals = Object.fromEntries(order.map(s => [s, 0]));\nfor (const s of sessions) {\n  const k = s.sport === 'VirtualRide' ? 'Ride' : s.sport;\n  if (totals[k] !== undefined) totals[k] += (s.duration_min || 0);\n}\n\nconst fmt = m => `${Math.floor(m / 60)}:${String(Math.round(m % 60)).padStart(2, '0')}`;\n\nconst lines = [\n  '📊 Week to date',\n  `${fires} ${fmt(totalMin)}h total`,\n  '',\n  ...order.map(s => `${sportEmoji[s]} · ${fmt(totals[s])}`),\n];\nreturn [{ json: { text: lines.join('\\n') } }];"
      }
    },
